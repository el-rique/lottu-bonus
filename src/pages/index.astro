---

<BaseLayout
  title="Lottu Bônus 2026: Ative sua Promoção e Jogue no Cassino"
  description="Descubra como ativar o Lottu Bônus de boas-vindas. Dobre seu primeiro depósito e aproveite os melhores slots como Fortune Tiger e Gates of Olympus."
  keywords="lottu bonus, lottu bônus, bonus lottu, cassino online, slots"
  canonical="https://lottu-bonus.com/"
  structuredData={structuredData}
  preloads={[
    {
      href: "/assets/media/hero-bg.webp",
      as: "image",
      type: "image/webp",
      fetchpriority: "high",
    },
  ]}
>
  <Header slot="before-main" variant="home" />

  <main>
    <section class="hero" id="hero">
      <div class="hero-text">
        <h1 class="hero__title">
          <span class="accent-text">Lottu Bônus:</span> O Guia Completo para Ativar
          sua Promoção
        </h1>
        <p class="hero__sub">
          Dobre seu primeiro depósito e aproveite os melhores slots do cassino
          online. Saiba tudo sobre como ativar e usar o Lottu Bônus em <span
            id="current-year-hero">2026</span
          >.
        </p>
      </div>
      <div class="hero__scroll-pattern">
        <div class="chevron-pattern">
          {
            chevronDelays.map((delay) => (
              <div class="chevron-col">
                <svg
                  class="chevron"
                  width="32"
                  height="16"
                  viewBox="0 0 32 16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  style={`animation-delay: ${delay}s`}
                >
                  <polyline
                    points="2,2 16,14 30,2"
                    stroke="#f8d441"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                </svg>
                <svg
                  class="chevron chevron--second"
                  width="32"
                  height="16"
                  viewBox="0 0 32 16"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                  style={`animation-delay: ${delay + 0.32}s`}
                >
                  <polyline
                    points="2,2 16,14 30,2"
                    stroke="#f8d441"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    fill="none"
                  />
                </svg>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <script type="application/ld+json" set:html={videoStructuredData} />

    <section class="grid-section" id="videos" aria-label="Slots Pagando Hoje">
      <div class="container">
        <h2 class="grid-section__header">
          Jogos Populares para Usar seu Lottu Bônus
        </h2>
        <div class="responsive-grid">
          {
            videoCards.map((card) => (
              <div class="grid-item">
                <a
                  href={card.href}
                  class="video-card"
                  aria-label={card.label}
                >
                  <div class="video-card__media">
                    <video
                      src={`/assets/media/${card.video}`}
                      poster={`/assets/media/${card.poster}`}
                      playsinline
                      autoplay
                      muted
                      loop
                      preload="metadata"
                      aria-label={card.label}
                    />
                  </div>
                  <div class="video-card__overlay">
                    <span class="video-card__badge">{card.badge}</span>
                  </div>
                  <div class="video-card__info">
                    <h3 class="video-card__title">{card.title}</h3>
                  </div>
                  <div class="video-card__bonus-btn">
                    <button type="button" class="btn-video-end">
                      <Fragment set:html={bonusBtnSvg} />
                      <span>Ativar Bônus Lottu</span>
                    </button>
                  </div>
                </a>
                <div class="grid__yt-link">
                  <a href={card.href}>
                    {card.desc}
