            loading="lazy"
            decoding="async"
            width="1200"
            height="630"
            style="position: absolute; height: 100%; width: 100%; left: 0; top: 0; right: 0; bottom: 0; color: transparent; object-fit: cover;"
            src="/assets/media/carlinhos-capa-site.e89a7664.avif"
          />
        </div>
      </div>
    </section>

    <div class="about-advantages">
      <section class="about" id="about">
        <div class="container">
          <div class="about-content">
            <h2>
              Sobre o Lottu Bônus, a maior e mais completo fansite da Lottu
