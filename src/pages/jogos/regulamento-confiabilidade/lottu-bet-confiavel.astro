  { question: "Meus dados estão realmente seguros?", answer: "Sim. A Lottu Bet utiliza criptografia SSL 256-bit, o mesmo padrão de segurança usado por bancos. Seus dados pessoais e financeiros são protegidos contra interceptação." },
  { question: "Quanto tempo leva para sacar?", answer: "Saques via PIX são processados em poucos minutos após a solicitação. Você receberá o dinheiro na sua conta bancária praticamente instantaneamente." },
  { question: "Há taxas ocultas?", answer: "Não. A Lottu Bet não cobra taxas para depósitos ou saques via PIX. O que você vê é o que você paga." },
  { question: "O que fazer se tiver um problema com a plataforma?", answer: "Entre em contato com o suporte ao cliente via Chat ao Vivo (disponível 24/7). Se o problema não for resolvido, você pode registrar uma reclamação no ReclameAqui ou procurar órgãos de proteção ao consumidor." },
];

const faqStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": { "@type": "Answer", "text": item.answer }
  }))
});

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Review",
  "itemReviewed": {
    "@type": "Organization",
    "name": "Lottu Bet"
  },
  "author": {
    "@type": "Organization",
    "name": "Lottu Bônus"
  },
  "datePublished": "2026-04-10",
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": "4.5",
    "bestRating": "5",
    "worstRating": "1"
  },
  "reviewBody": "Análise completa da Lottu Bet como plataforma de cassino online confiável."
});

const preloads: { href: string; as: string }[] = [];
