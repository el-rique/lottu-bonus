  },
];

const faqStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
});

const preloads = [
  { href: "https://static.sportingtech.com/esportesdasortevip/upload_files/Esportes-da-sorte-vira-lata-caramelo-slot.jpg", as: "image" },
  { href: "https://static.sportingtech.com/esportesdasortevip/upload_files/Vira-lata-Caramelo-tela-game.jpg", as: "image" },
  { href: "https://static.sportingtech.com/esportesdasortevip/upload_files/Vira-lata-Caramelo.jpg", as: "image" },
  { href: "https://static.sportingtech.com/esportesdasortevip/upload_files/reclameaqui.png", as: "image" },
];
