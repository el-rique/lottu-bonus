---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import FAQ from "../../../components/FAQ.astro";
import "../../../styles/game-detail.css";

const AFFILIATE = "https://www.lottu.bet.br/register?affiliate_id=68a88453de213f0029a2b34d&ngx_campaign_id=68e52977e8f18f00097fd1fd&ngx_source_id=sitelottubonus";

const faqItems = [
  {
    question: "Como posso começar a jogar Double Fortune?",
    answer: "Basta criar uma conta no Lottu, acessar o jogo Double Fortune e escolher o valor da aposta; os rolos girarão automaticamente.",
  },
  {
    question: "Posso jogar Double Fortune em dispositivos móveis?",
    answer: "Sim. Double Fortune é compatível com celulares, tablets e computadores e a interface é otimizada para telas menores.",
  },
  {
    question: "Como funcionam os símbolos duplos no Double Fortune?",
    answer: "Os símbolos duplos contam como dois ícones iguais, aumentando a chance de formar combinações de alto valor durante os giros.",
  },
  {
    question: "Como ativar os giros grátis?",
    answer: "Consiga 3 ou mais símbolos Scatter (a letra dourada Double) para ativar os giros grátis; durante o bônus os multiplicadores podem se acumular.",
  },
  {
    question: "Posso jogar Double Fortune grátis?",
    answer: "Sim. O Lottu oferece modo demo onde você testa o jogo sem arriscar saldo real para entender símbolos e bônus.",
  },
];

const faqStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
});

const preloads = [
  { href: "https://static.sportingtech.com/esportesdasortevip/upload_files/double-fortune-capa-jogo-esportes-da-sorte.webp", as: "image" },
  { href: "https://static.sportingtech.com/esportesdasortevip/upload_files/double-fortune-tela-inicial-slot.webp", as: "image" },
  { href: "https://static.sportingtech.com/esportesdasortevip/upload_files/double-fortune-tela-ganho.webp", as: "image" },
  { href: "https://static.sportingtech.com/esportesdasortevip/upload_files/double-fortune-tela-mega-ganho.webp", as: "image" },
  { href: "https://static.sportingtech.com/esportesdasortevip/upload_files/reclameaqui.png", as: "image" },
];
---

<BaseLayout
  title="Double Fortune | Slot de Símbolos Duplos - Lottu Cassino"
  description="Jogue Double Fortune no Lottu Cassino: símbolos duplos, giros grátis e multiplicadores acumulados. Veja como funciona, teste a demo e aumente suas chances."
