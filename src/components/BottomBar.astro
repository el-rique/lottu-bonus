<style>
  .bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    background-color: var(--color-dark);
    z-index: 99;
    border-top: 2px solid #f0f0f02d;
    padding: 0;
  }

  .bottom-bar-buttons {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: stretch;
    padding: 8px 28px 4px;
    margin: 0 auto;
  }

  .bottom-bar-buttons button {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    flex-direction: column;
    width: 60px;
    height: 100%;
    padding: 0;
  }

  .bottom-bar p { font-size: 9px; line-height: 1; }

  @media (max-width: 768px) {
    .bottom-bar-buttons { max-width: 420px; }
  }

  @media (min-width: 769px) {
    .bottom-bar { display: none; }
  }
</style>
